# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

node_modules/
client/dist/
client/dist-http/
client/dist-release-stub/
client/dist-release-http/
client/dist-probe/
# The engine build (cargo xtask build-wasm, plan #68 C1); only its .d.ts and layout are committed.
client/src/engine/wasm/gen/
# The probe build's engine (cargo xtask build-wasm --probe, plan #68 C2a1; e2e:shim-fuzz only).
client/src/engine/wasm/gen-probe/
# TypeScript incremental build state (tsc -b)
*.tsbuildinfo
test-results/
playwright-report/
blob-report/

# Server build output and pinned tools (make server-build, make tools-ci)
build/
# ...but not the geo build fixtures (tools/geo/build.py --fixtures, plan #231)
!client/src/vis/geo/fixtures/build/
# The packed client the BFF embeds (make assets-pack)
server/internal/gateway/static/dist/

# Local dev stack settings, including the real PulsusDB URL (docs/development/dev-stack.md)
dev/local.env
__pycache__/

# Local cargo cache used during code review (never tracked)
.review-cache/
