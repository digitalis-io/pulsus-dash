{
  "forbiddenCategories": ["charting", "mapping", "3d", "graph-diagram", "css-in-js"],
  "runtimeAllowlist": [
    "react",
    "react-dom",
    "react-router",
    "@tanstack/react-query",
    "react-aria-components",
    "@internationalized/date",
    "openapi-fetch",
    "react-grid-layout",
    "@codemirror/autocomplete",
    "@codemirror/commands",
    "@codemirror/language",
    "@codemirror/lint",
    "@codemirror/state",
    "@codemirror/view",
    "@lezer/common",
    "@lezer/highlight",
    "@prometheus-io/codemirror-promql",
    "@prometheus-io/lezer-promql",
    "@tanstack/react-virtual",
    "commonmark",
    "parse5",
    "parse5-sax-parser"
  ],
  "runtimeClosure": {
    "ui-framework": ["react", "react-dom", "scheduler", "use-sync-external-store"],
    "routing": ["react-router", "cookie-es", "@remix-run/route-pattern"],
    "server-state": ["@tanstack/react-query", "@tanstack/query-core"],
    "accessible-components": [
      "react-aria-components",
      "react-aria",
      "react-stately",
      "@react-types/shared",
      "aria-hidden",
      "clsx",
      "client-only"
    ],
    "i18n": ["@internationalized/date", "@internationalized/number", "@internationalized/string"],
    "api-client": ["openapi-fetch", "openapi-typescript-helpers"],
    "runtime-helper": ["@swc/helpers", "tslib"],
    "board-layout": [
      "react-grid-layout",
      "react-draggable",
      "react-resizable",
      "fast-equals",
      "prop-types",
      "object-assign",
      "loose-envify",
      "js-tokens",
      "react-is",
      "resize-observer-polyfill"
    ],
    "query-editor": [
      "@codemirror/autocomplete",
      "@codemirror/commands",
      "@codemirror/language",
      "@codemirror/lint",
      "@codemirror/state",
      "@codemirror/streamparser",
      "@codemirror/view",
      "@lezer/common",
      "@lezer/highlight",
      "@lezer/lr",
      "@marijn/find-cluster-break",
      "@prometheus-io/codemirror-promql",
      "@prometheus-io/lezer-promql",
      "crelt",
      "lru-cache",
      "style-mod",
      "w3c-keyname"
    ],
    "virtual-list": ["@tanstack/react-virtual", "@tanstack/virtual-core"],
    "markdown": ["commonmark", "parse5", "parse5-sax-parser", "entities", "mdurl", "minimist"]
  },
  "licenceAllowlist": [
    "MIT",
    "ISC",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "Apache-2.0",
    "0BSD",
    "MPL-2.0"
  ],
  "licenceExceptionAllowlist": [],
